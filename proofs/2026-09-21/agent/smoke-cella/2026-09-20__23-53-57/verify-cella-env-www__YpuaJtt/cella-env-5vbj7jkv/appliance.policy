# The appliance border (titanium's engine): the world leg,
# judged by the resolved name. ARP, the upstream resolver,
# the member's reply window, and each allowed world host.
release outgoing arp (keep_open=24h) (skip_freeze=true)
release incoming arp
release outgoing 9.9.9.9:53/udp (keep_open=24h) (skip_freeze=true)
release incoming 9.9.9.9:53/udp
# The member's reply window (the consistent reply port): the
# member pins its ephemeral ports to this range, so a crossing
# to the member is named by one of these exact ports -- both
# the member's request arriving (incoming, named by its source
# port) and the appliance's answer going back (outgoing).
release outgoing 10.77.0.2:50000/tcp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50000/tcp
release outgoing 10.77.0.2:50000/udp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50000/udp
release outgoing 10.77.0.2:50001/tcp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50001/tcp
release outgoing 10.77.0.2:50001/udp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50001/udp
release outgoing 10.77.0.2:50002/tcp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50002/tcp
release outgoing 10.77.0.2:50002/udp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50002/udp
release outgoing 10.77.0.2:50003/tcp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50003/tcp
release outgoing 10.77.0.2:50003/udp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50003/udp
release outgoing 10.77.0.2:50004/tcp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50004/tcp
release outgoing 10.77.0.2:50004/udp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50004/udp
release outgoing 10.77.0.2:50005/tcp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50005/tcp
release outgoing 10.77.0.2:50005/udp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50005/udp
release outgoing 10.77.0.2:50006/tcp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50006/tcp
release outgoing 10.77.0.2:50006/udp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50006/udp
release outgoing 10.77.0.2:50007/tcp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50007/tcp
release outgoing 10.77.0.2:50007/udp (keep_open=1h) (skip_freeze=true)
release incoming 10.77.0.2:50007/udp
# The allowed world hosts, by name.
release outgoing example.com:443/tcp (keep_open=60m) (skip_freeze=true)
release incoming example.com:443/tcp
release outgoing example.com:80/tcp (keep_open=60m) (skip_freeze=true)
release incoming example.com:80/tcp
release outgoing openrouter.ai:443/tcp (keep_open=60m) (skip_freeze=true)
release incoming openrouter.ai:443/tcp
release outgoing openrouter.ai:80/tcp (keep_open=60m) (skip_freeze=true)
release incoming openrouter.ai:80/tcp
