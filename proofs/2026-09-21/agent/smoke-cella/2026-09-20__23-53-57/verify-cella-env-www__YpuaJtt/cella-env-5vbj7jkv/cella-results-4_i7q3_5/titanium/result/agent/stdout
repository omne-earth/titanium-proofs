#!/usr/bin/env python3
"""Network egress probe -> /app/report.json.

Probes:
  * three sequential HTTPS GETs to the granted name example.com
  * one HTTPS GET to the ungranted name example.org
  * DNS resolution of both names
and records the guest/system facts asked for.  Short timeouts are used
so a blocked probe cannot hang the run; the report is always valid JSON.
"""
import json
import os
import socket
import ssl
import time
import urllib.error
import urllib.request

GRANTED = "example.com"
DENIED = "example.org"
TIMEOUT = 5.0            # short per-probe timeout (seconds)
REPORT = "/app/report.json"


def https_get(host, timeout=TIMEOUT):
    """Do one HTTPS GET.  Returns (start_epoch, secs, ok)."""
    url = "https://%s/" % host
    start = time.time()
    ok = False
    try:
        ctx = ssl.create_default_context()
        req = urllib.request.Request(
            url, headers={"Host": host, "User-Agent": "egress-probe/1.0"}
        )
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
            status = getattr(resp, "status", None) or resp.getcode()
            resp.read(1)  # make sure the response actually completes a little
            ok = 200 <= int(status) < 400
    except Exception:
        ok = False
    secs = time.time() - start
    return start, secs, ok


def resolve(host):
    """Return the list of IP address strings the name resolves to."""
    addrs = []
    try:
        infos = socket.getaddrinfo(host, 443, proto=socket.IPPROTO_TCP)
    except Exception:
        return addrs
    for info in infos:
        sockaddr = info[4]
        if sockaddr and sockaddr[0] not in addrs:
            addrs.append(sockaddr[0])
    return addrs


def cpu_count():
    try:
        return len(os.sched_getaffinity(0))
    except Exception:
        return os.cpu_count() or 1


def mem_total_kb():
    with open("/proc/meminfo") as fh:
        for line in fh:
            if line.startswith("MemTotal:"):
                return int(line.split()[1])
    return None


def main():
    # --- three sequential HTTPS GETs to the granted name ---
    calls = []
    granted_ok = True
    for _ in range(3):
        start, secs, ok = https_get(GRANTED)
        calls.append({"measured_at": round(start, 3), "secs": round(secs, 3)})
        granted_ok = granted_ok and ok

    # --- one HTTPS GET to the ungranted name ---
    _d_start, _d_secs, denied_ok = https_get(DENIED)
    denied_blocked = not denied_ok

    # --- DNS comparison ---
    granted_addrs = resolve(GRANTED)
    denied_addrs = resolve(DENIED)
    common = None
    for addr in granted_addrs:
        if addr in denied_addrs:
            common = addr
            break
    resolver_is_gateway = common is not None
    resolver_address = common
    if resolver_address is None:
        # fall back to whatever the granted name resolved to (first address)
        resolver_address = granted_addrs[0] if granted_addrs else None

    # --- system facts ---
    try:
        with open("/proc/1/comm") as fh:
            pid1_comm = fh.read().strip()
    except Exception:
        pid1_comm = None

    report = {
        "granted_https_ok": bool(granted_ok),
        "calls": calls,
        "denied_https_blocked": bool(denied_blocked),
        "resolver_is_gateway": bool(resolver_is_gateway),
        "resolver_address": resolver_address,
        "pid1_comm": pid1_comm,
        "uid": os.getuid(),
        "nproc": cpu_count(),
        "mem_total_kb": mem_total_kb(),
        "kernel_release": os.uname().release.strip(),
    }

    with open(REPORT, "w") as fh:
        json.dump(report, fh, indent=2)
        fh.write("\n")
    print(json.dumps(report, indent=2))


if __name__ == "__main__":
    main()
