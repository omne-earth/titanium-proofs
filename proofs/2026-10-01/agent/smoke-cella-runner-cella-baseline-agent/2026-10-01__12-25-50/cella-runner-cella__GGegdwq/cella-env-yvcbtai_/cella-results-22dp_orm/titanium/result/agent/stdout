    report['kvm_device'] = os.path.exists('/dev/kvm')
except OSError:
    report['kvm_device'] = False

# net_interfaces: sorted /sys/class/net entries
try:
    report['net_interfaces'] = sorted(os.listdir('/sys/class/net'))
except OSError:
    report['net_interfaces'] = []

# egress_tcp_denied: a TCP connect to 1.1.1.1:443 with a short timeout
# did NOT succeed.
try:
    sock = socket.create_connection(('1.1.1.1', 443), timeout=2)
    sock.close()
    report['egress_tcp_denied'] = False
except OSError:
    report['egress_tcp_denied'] = True
except Exception:
    report['egress_tcp_denied'] = True

# uid: the numeric user id
report['uid'] = os.getuid()

# kernel_release: uname -r, stripped (informational)
try:
    report['kernel_release'] = os.uname().release.strip()
except OSError:
    try:
        report['kernel_release'] = os.popen('uname -r').read().strip()
    except Exception:
        report['kernel_release'] = ''

with open('/app/report.json', 'w') as fh:
    json.dump(report, fh, indent=2, sort_keys=True)
    fh.write('\n')
